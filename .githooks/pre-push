#!/usr/bin/env sh
set -eu

php artisan deployment-data:export --quiet

if ! git diff --quiet -- database/data/deployable-catalog.json; then
    echo "Deployable business database data changed after the last commit."
    echo "Commit database/data/deployable-catalog.json, then push again."
    exit 1
fi

if [ -n "$(git status --porcelain --untracked-files=normal -- storage/app/public)" ]; then
    echo "Deployable media changed after the last commit."
    echo "Commit storage/app/public media, then push again."
    exit 1
fi
