#!/usr/bin/env sh
set -eu

remote_name="${1:-origin}"
remote_ref="refs/remotes/${remote_name}/main"

if git rev-parse --verify --quiet "${remote_ref}" >/dev/null; then
    if ! git diff --diff-filter=AMCR --quiet "${remote_ref}..HEAD" -- \
        database/data/deployable-catalog.json \
        ':(glob)storage/app/public/**' \
        ':(exclude)storage/app/public/.gitignore'; then
        echo "Push blocked: local catalog snapshot or uploaded media is included."
        echo "Manage products, users and shipping data only from www.tisilo.com."
        exit 1
    fi
fi
