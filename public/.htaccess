<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

# Cache fingerprinted/static storefront files while keeping Laravel responses private.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/otf "access plus 30 days"
    ExpiresByType font/ttf "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType audio/mpeg "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "(?i)\.(?:avif|bmp|css|eot|gif|ico|jpe?g|js|mp3|mp4|ogg|otf|png|svg|ttf|webm|webp|woff2?)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
        Header set Cloudflare-CDN-Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>

    <FilesMatch "(?i)\.(?:php|html?)$">
        Header always set Cache-Control "no-store, private"
        Header always set Cloudflare-CDN-Cache-Control "no-store"
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# A legacy full Laravel tree may still exist in public_html after the first
# non-destructive cPanel cutover. Keep application source and secrets private.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>

RewriteRule ^(?:app|bootstrap|cache|config|database|public|resources|routes|tests|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^storage/(?:app|framework|logs|private)(?:/|$) - [F,L,NC]
RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

# Handle Authorization Header
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Handle X-XSRF-Token Header
RewriteCond %{HTTP:x-xsrf-token} .
RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

# Redirect Trailing Slashes If Not A Folder...
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [L,R=301]

# Send Requests To Front Controller...
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
